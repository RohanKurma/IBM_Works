# Copy to .env and add your IBM watsonx.ai credentials.
# (With no keys set, the app still runs and answers with a template-based fallback.)

# auto | watsonx | openai | none
LLM_PROVIDER=watsonx
LLM_MAX_TOKENS=400

# --- IBM watsonx.ai (Granite) ---
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small

# --- Optional alternative: any OpenAI-compatible API (OpenAI, Groq, Together, Ollama, LM Studio...) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Local Ollama example: LLM_PROVIDER=openai, OPENAI_API_KEY=ollama,
#                       OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_MODEL=llama3.1

# --- Retrieval ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Set to persist the index on disk instead of rebuilding it in memory on startup
# CHROMA_PERSIST_DIR=.chroma
